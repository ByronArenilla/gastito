# Copia este archivo como .env y rellena los valores. NUNCA subas .env a Git.

# Base de datos. En local, SQLite. Desplegada, la URL de PostgreSQL que da el
# proveedor (postgresql://usuario:clave@host/base?sslmode=require): se pega en
# el panel de Render, nunca en un archivo del repositorio.
DATABASE_URL=sqlite:///./budget.db

# Contraseña del PostgreSQL local de `make up` (compose.yaml). Inventa una:
# solo existe en tu computador.
POSTGRES_PASSWORD=

# URL de la API que usará la web (spec 010)
API_URL=http://localhost:8000

# URL pública de la web. La API la usa para armar los enlaces de invitación
# (<WEB_BASE_URL>/unirse/<token>) y es el único origen al que deja leer sus
# respuestas (CORS, spec 011).
WEB_BASE_URL=http://localhost:8080

# Zona horaria para calcular a qué mes pertenece un gasto
TZ=America/Bogota

# Desde dónde escuchan `make run-api` y `make run-web`. 127.0.0.1 solo deja
# entrar desde este computador. Para probar desde el celular en la red de la
# casa, pon 0.0.0.0 y cambia API_URL y WEB_BASE_URL por la IP del computador
# (por ejemplo http://192.168.1.20:8000 y http://192.168.1.20:8080).
BIND_HOST=127.0.0.1
